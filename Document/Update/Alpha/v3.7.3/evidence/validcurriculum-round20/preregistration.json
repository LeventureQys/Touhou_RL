  "criterion": {
    "round": "round20",
    "purpose": "first honest teacher distillation on the R18-valid curriculum, read out as a grouped-holdout horizontal_masked closed loop",
    "data": {
      "source": "R18 run/manifest.json (28 worlds, 14 groups of base+mirror) joined with the frozen R19 run/split.json; no world regenerated, no parameter changed, no budget added, no test split",
      "train": {
        "events": 14,
        "groups": 7,
        "groups_per_family": {
          "F1": 3,
          "F2": 1,
          "F3": 3
        },
        "use": "the only events that are rendered, labelled, encoded or trained on"
      },
      "validation": {
        "events": 14,
        "groups": 7,
        "groups_per_family": {
          "F1": 3,
          "F2": 1,
          "F3": 3
        },
        "use": "read-only: never trained, never labelled, never encoded; closed loop only"
      },
      "mirror_note": "a group is atomic: the mirror is not an independent sample and never lands in the other split"
    },
    "rollout": {
      "teacher": "TacticalTeacherV2, unmodified, module SHA frozen",
      "driver": "touhou_rl.tactical_teacher_v2.rollout: decide() then advance() the actual chosen action, so the world is advanced causally by executed actions only",
      "horizon": 160,
      "decisions": 80,
      "verify": "tactical_teacher_validation.verify(world, all 80 actions), full horizon, no early stop",
      "pass_required": "verdict == feasible",
      "non_pass_rule": "an event whose teacherV2 rollout does not verify to feasible is excluded from supervision (action_valid all False) and retained as a failure; expected 0 because R19 measured 28/28"
    },
    "render": {
      "source": "touhou_rl.tactical_synthetic_pixels.render_state / full_states, unchanged: the exact R10 renderer used for the R10 records",
      "depth": 3,
      "causal_frames": "[max(0,f-4), max(0,f-2), f] logical frames, chronological, repeat-initial padding",
      "sampling": "decision i uses logical frame f=2*i for i in 0..79",
      "regions": "unchanged ROI crop + area resize: playfield 224x192, hud_score 34x216, hud_status 126x216",
      "hidden": "no future wall/window/goal geometry, no teacher target, option, countdown or hit state is ever drawn",
      "storage": {
        "dtype": "uint8 (the renderer output verbatim, never cast to float on disk)",
        "container": "npz deflate for the pixel regions, torch.save (xb) for history/labels",
        "scale": "uint8 -> float32 /255 happens only at load through vision.regions_to_batch",
        "hud": "hud_score/hud_status are byte-identical across all 80 decisions (asserted per event); stored once as [1,3,H,W,C] and expanded to 80 rows at load, so the values are identical while the 80 redundant copies are not written",
        "why": "a float32 copy of the same content is 4x larger and adds nothing: every consumer divides by 255 immediately"
      },
      "labels": "action_positive = the one-hot of the single successful teacher route first action; action_valid = teacher_verified; nothing else",
      "history": "actual executed candidate (ACTION_MAP), previous_hold 2, frame_delta 2, option BOS3, target_valid false, history_valid from row 1"
    },
    "training": {
      "arms": {
        "A": "no anchor: the unchanged tactical_policy_loss",
        "B": "L_original + 1.0*KL(base||policy) over every action_valid row"
      },
      "formula": "Arm B only, weight fixed at 1.0 before the run. For the full-80 batch let a=policy_logits [1,80,18], b=the frozen baseline policy_logits of the same encoded rows (detached, no gradient into the backbone), V={i: action_valid_i}, N=|V|, KL_anchor=(1/N)*sum_{i in V} sum_c softmax(b_i)_c*(log softmax(b_i)_c-log softmax(a_i)_c), i.e. KL(base||policy) in nats averaged over every action_valid row (F.kl_div(log_target=True, reduction=\"batchmean\") on the masked rows). L_total(B)=L_original+1.0*KL_anchor, L_total(A)=L_original. L_original is the unchanged tactical_policy_loss (action 1.0, option .2, target .5, termination .2, slack .1, local 1.0); the action-only labels leave option/target/termination/slack/local empty so they contribute exactly 0 in both arms. The R17 functional form is reused unchanged; the weight is never tuned on any result.",
      "anchor_weight": 1.0,
      "seeds": [
        7,
        17,
        27
      ],
      "updates": 200,
      "optimizer": "Adam",
      "lr": 0.001,
      "clip": 1.0,
      "sequence": 80,
      "batch": 1,
      "precision": "FP32 without AMP, autocast disabled, matmul TF32 False, cuDNN TF32 False, float32 matmul precision highest",
      "features": "one shared encode pass per event over 5 chunks of 16 rows, identical tensors for both arms, no disk feature cache",
      "initialization": "fresh torch seed reset immediately before every N1 construction after the backbone load; the same seed must produce a byte-identical initial head state in both arms (hard assertion) and must equal the frozen R16/R17 initial head state for that seed",
      "order": "verified train events in R18 manifest order, step modulo the supervised count; all 200 updates must be supervised",
      "selection": "final step only: no early stopping, no validation-based model selection, no tuning of lr/clip/weight/epochs/order"
    },
    "evaluation": {
      "order": "all six checkpoints written and SHA-frozen first; only then B0 and the six R18 baselines on the same validation renders, then the six checkpoints on validation, then the six on train (seen)",
      "condition": "horizontal_masked",
      "runner": "unchanged R11 run_event / pixel_stack / render_state / executed_history: 18 logits masked to the six supported candidates before argmax, candidate -> two-frame action, real advance, sticky collision, continue to the full horizon, per-event hidden reset",
      "b0": "the frozen baseline policy logits only on the identical renders; a reference, never a B0 capability claim",
      "six_baselines": "R18 policies()/causal_loop()/outcome() re-executed on the validation worlds: hold, constant right (+2), constant left (-2), alternate every 16 decisions, random seed 37318 over the six supported candidates, weak teacher-first-action",
      "holdout_rule": "if ANY of the six R18 baselines is feasible on ANY validation event then the R18 filter has failed on the holdout side: report it verbatim, set holdout_filter_valid=False and withhold the learning conclusion of this round",
      "metrics": "per arm per seed per family feasible and survived counts plus every event firsthit; the train (seen) split reported separately and marked as seen; action distribution hold/right/left share and median switches",
      "reporting": "per family F1/F2/F3, never only aggregated; n=3 seeds; F2 validation has one group; mirrors are not independent samples",
      "degeneracy": "a run is constant when one candidate occupies all 80 decisions of an event and two-segment when switches<=1; both are counted, listed and reported, never dropped silently"
    },
    "claims": {
      "significance": "none: 3 seeds, 7 validation groups, at most 14 independent geometries (F2 has 2 nearly identical); this is a descriptive comparison, not a significance test",
      "gate": "no formal gate opened, no deployable checkpoint produced, no game executed",
      "can_show": "whether a fixed 200-update supervised head trained on 14 seen teacher rollouts preserves or improves the horizontal_masked closed loop on 14 unseen worlds, and whether the frozen-base KL anchor changes that",
      "cannot_show": "generalisation beyond 7 held-out geometries, tactical understanding, or that the teacher is learnable in any formal sense"
    },
    "failure_policy": "first failure retained; one run; no retrain, rerun, repair, overwrite, extra epoch or baseline switch"
  },
