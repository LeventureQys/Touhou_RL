diff --git a/src/rlharness/rlharness.cpp b/src/rlharness/rlharness.cpp
new file mode 100644
index 0000000..da95c47
--- /dev/null
+++ b/src/rlharness/rlharness.cpp
@@ -0,0 +1,341 @@
+// v4.0.0 reinforcement-learning harness (10-P0 WP3): control protocol + state export.
+//
+// Design notes
+// ------------
+// * The control channel is line-oriented ASCII over a pair of pipes.  Bulk data
+//   (pixels, full StateExport) belongs in shared memory per 03 §4.2; this first
+//   slice keeps control + the 25 tracked fields on the pipe so the plumbing can
+//   be tested end to end before the shared-memory layout is frozen.
+// * The 25 tracked fields are copied verbatim from replay_trace.cpp, which is
+//   the field set already proven bit-identical against the retail replay corpus.
+//   Reusing those exact expressions is deliberate: the hash this produces is the
+//   same hash G0.2 compares against.
+// * Every command that advances time goes through PumpOneFrame() in main.cpp,
+//   which is the no-timing-gate twin of GameWindow::Render().
+
+#ifdef TH08_RL_HARNESS
+
+#include "rlharness.hpp"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "GameManager.hpp"
+#include "Player.hpp"
+#include "ReplayManager.hpp"
+#include "Gui.hpp"
+
+namespace th08
+{
+namespace modern
+{
+namespace rlharness
+{
+namespace
+{
+bool g_active;
+FILE *g_in;
+FILE *g_out;
+u16 g_mask;
+u32 g_stageOrigin[MAX_STAGES];
+bool g_stageOriginSet[MAX_STAGES];
+
+u32 FloatBits(const f32 &value)
+{
+    u32 bits;
+    memcpy(&bits, &value, sizeof(bits));
+    return bits;
+}
+
+// FNV-1a, 64 bit.  Deterministic across platforms because it only ever sees u32.
+RlU64 Fnv1a(RlU64 hash, u32 value)
+{
+    hash ^= static_cast<RlU64>(value);
+    hash *= 1099511628211ULL;
+    return hash;
+}
+
+// Fill the 25 tracked fields, identical in order to the replay-trace row.
+// Returns false when the engine is not in a state where the fields are defined.
+bool TrackedFields(u32 out[25])
+{
+    if (!g_GameManager.globals)
+        return false;
+    const int stage = g_GameManager.currentStage;
+    if (stage < 0 || stage >= MAX_STAGES)
+        return false;
+
+    const u32 generation = g_Rng.ReplayTraceGenerationCount();
+    if (!g_stageOriginSet[stage])
+    {
+        g_stageOrigin[stage] = generation;
+        g_stageOriginSet[stage] = true;
+    }
+
+    const ZunGlobals &globals = *g_GameManager.globals;
+    u32 row[25] = {
+        static_cast<u32>(FrameCount()),
+        static_cast<u32>(stage),
+        static_cast<u32>(g_ReplayManager ? g_ReplayManager->frameCounter : 0),
+        g_GameManager.gameplayFrameCounter,
+        globals.score,
+        static_cast<u32>(globals.graze),
+        FloatBits(globals.deaths),
+        FloatBits(globals.livesRemaining),
+        FloatBits(globals.bombsRemaining),
+        FloatBits(globals.playerPower),
+        FloatBits(g_Player.position.x),
+        FloatBits(g_Player.position.y),
+        FloatBits(g_Player.position.z),
+        static_cast<u8>(g_Player.playerState),
+        g_Rng.GetSeed(),
+        generation - g_stageOrigin[stage],
+        g_GuiMessageInputCurrent,
+        static_cast<u32>(globals.pointItemsCollected),
+        static_cast<u32>(globals.currentTimeOrbs),
+        static_cast<u32>(globals.youkaiGauge),
+        static_cast<u8>(globals.clockTime),
+        static_cast<u32>(globals.pointItemValue),
+        g_GameManager.character,
+        g_GameManager.shotType,
+        static_cast<u32>(g_GameManager.difficulty),
+    };
+    memcpy(out, row, sizeof(row));
+    return true;
+}
+
+void Reply(const char *fmt, ...)
+{
+    va_list args;
+    va_start(args, fmt);
+    vfprintf(g_out, fmt, args);
+    va_end(args);
+    fputc('\n', g_out);
+    fflush(g_out);
+}
+
+const char *RoleName()
+{
+    return "env";
+}
+
+void HandleHello()
+{
+    Reply("OK hello proto=%u harness=1 role=%s frames=%llu", PROTOCOL_VERSION, RoleName(),
+          static_cast<unsigned long long>(FrameCount()));
+}
+
+void HandleFrame()
+{
+    Reply("OK frame=%llu", static_cast<unsigned long long>(FrameCount()));
+}
+
+void HandleHash()
+{
+    u32 fields[25];
+    if (!TrackedFields(fields))
+    {
+        Reply("OK hash=undefined frames=%llu", static_cast<unsigned long long>(FrameCount()));
+        return;
+    }
+    RlU64 hash = 14695981039346656037ULL;
+    for (int i = 0; i < 25; ++i)
+        hash = Fnv1a(hash, fields[i]);
+    Reply("OK hash=%016llx frames=%llu", static_cast<unsigned long long>(hash),
+          static_cast<unsigned long long>(FrameCount()));
+}
+
+void HandleState()
+{
+    u32 fields[25];
+    if (!TrackedFields(fields))
+    {
+        Reply("OK state=undefined frames=%llu", static_cast<unsigned long long>(FrameCount()));
+        return;
+    }
+    // A flat, fixed-order dump so the Python side can diff two states field by field.
+    Reply("OK frames=%llu f0=%u f1=%u f2=%u f3=%u f4=%u f5=%u f6=%08x f7=%08x f8=%08x f9=%08x "
+          "f10=%08x f11=%08x f12=%08x f13=%u f14=%u f15=%u f16=%u f17=%u f18=%u f19=%u f20=%u "
+          "f21=%u f22=%u f23=%u f24=%u",
+          static_cast<unsigned long long>(FrameCount()),
+          fields[0], fields[1], fields[2], fields[3], fields[4], fields[5], fields[6], fields[7],
+          fields[8], fields[9], fields[10], fields[11], fields[12], fields[13], fields[14],
+          fields[15], fields[16], fields[17], fields[18], fields[19], fields[20], fields[21],
+          fields[22], fields[23], fields[24]);
+}
+
+// STEP <mask> <frames>: hold `mask` for `frames` logic frames, then report.
+void HandleStep(char *args)
+{
+    unsigned mask = 0;
+    unsigned frames = 0;
+    if (sscanf(args, "%u %u", &mask, &frames) != 2)
+    {
+        Reply("ERR step-usage STEP <mask> <frames>");
+        return;
+    }
+    if (frames > 100000)
+    {
+        Reply("ERR step-too-many");
+        return;
+    }
+    g_mask = static_cast<u16>(mask);
+    unsigned advanced = 0;
+    for (unsigned i = 0; i < frames; ++i)
+    {
+        if (!PumpOneFrame())
+        {
+            Reply("OK advanced=%u frame=%llu exit=1", advanced,
+                  static_cast<unsigned long long>(FrameCount()));
+            return;
+        }
+        ++advanced;
+    }
+    u32 fields[25];
+    RlU64 hash = 0;
+    if (TrackedFields(fields))
+    {
+        hash = 14695981039346656037ULL;
+        for (int i = 0; i < 25; ++i)
+            hash = Fnv1a(hash, fields[i]);
+    }
+    Reply("OK advanced=%u frame=%llu hash=%016llx", advanced,
+          static_cast<unsigned long long>(FrameCount()), static_cast<unsigned long long>(hash));
+}
+} // namespace
+
+bool ParseCommandLine()
+{
+    int inFd = 0;
+    int outFd = 1;
+    bool requested = false;
+
+    // The platform layer keeps argv in an anonymous namespace inside
+    // linux_runtime.cpp, so it has internal linkage and cannot be reached from
+    // another translation unit.  /proc/self/cmdline is the same data and lets
+    // the harness stay out of the platform layer entirely.
+    char buffer[4096];
+    FILE *cmdline = fopen("/proc/self/cmdline", "rb");
+    if (cmdline == NULL)
+        return false;
+    size_t total = fread(buffer, 1, sizeof(buffer) - 1, cmdline);
+    fclose(cmdline);
+    buffer[total] = '\0';
+
+    const char *args[128];
+    int count = 0;
+    const char *cursor = buffer;
+    const char *end = buffer + total;
+    while (cursor < end && count < 128)
+    {
+        args[count++] = cursor;
+        cursor += strlen(cursor) + 1;
+    }
+
+    for (int i = 1; i < count; ++i)
+    {
+        const char *arg = args[i];
+        if (strcmp(arg, "--rl-control") == 0 && i + 1 < count)
+        {
+            requested = true;
+            ++i;
+            if (sscanf(args[i], "%d,%d", &inFd, &outFd) != 2)
+            {
+                inFd = 0;
+                outFd = 1;
+            }
+        }
+        else if (strncmp(arg, "--rl-control=", 13) == 0)
+        {
+            requested = true;
+            if (sscanf(arg + 13, "%d,%d", &inFd, &outFd) != 2)
+            {
+                inFd = 0;
+                outFd = 1;
+            }
+        }
+    }
+    if (!requested)
+        return false;
+
+    g_in = fdopen(inFd, "r");
+    g_out = fdopen(outFd, "w");
+    if (!g_in || !g_out)
+        return false;
+    // The control channel must stay unbuffered on the reply side; replies are
+    // small and the Python side blocks on them.
+    setvbuf(g_out, NULL, _IONBF, 0);
+    g_mask = 0;
+    g_active = true;
+    return true;
+}
+
+bool IsActive()
+{
+    return g_active;
+}
+
+u16 CurrentMask()
+{
+    return g_mask;
+}
+
+void SetMask(u16 mask)
+{
+    g_mask = mask;
+}
+
+int Run()
+{
+    char line[4096];
+    u32 fields[25];
+    if (TrackedFields(fields))
+    {
+        // Nothing to do; the first STEP defines the stage origin.  The call is
+        // here so the origin is captured before any frame is advanced.
+    }
+    while (fgets(line, sizeof(line), g_in) != NULL)
+    {
+        size_t len = strlen(line);
+        while (len > 0 && (line[len - 1] == '\n' || line[len - 1] == '\r'))
+            line[--len] = '\0';
+        if (len == 0)
+            continue;
+
+        char *space = strchr(line, ' ');
+        char *args = NULL;
+        if (space)
+        {
+            *space = '\0';
+            args = space + 1;
+        }
+
+        if (strcmp(line, "HELLO") == 0)
+            HandleHello();
+        else if (strcmp(line, "PING") == 0)
+            Reply("OK pong");
+        else if (strcmp(line, "FRAME") == 0)
+            HandleFrame();
+        else if (strcmp(line, "HASH") == 0)
+            HandleHash();
+        else if (strcmp(line, "STATE") == 0)
+            HandleState();
+        else if (strcmp(line, "STEP") == 0)
+            HandleStep(args ? args : (char *)"");
+        else if (strcmp(line, "QUIT") == 0)
+        {
+            Reply("OK bye");
+            return 0;
+        }
+        else
+            Reply("ERR unknown-command %s", line);
+    }
+    return 0;
+}
+} // namespace rlharness
+} // namespace modern
+} // namespace th08
+
+#endif // TH08_RL_HARNESS
diff --git a/src/rlharness/rlharness.hpp b/src/rlharness/rlharness.hpp
new file mode 100644
index 0000000..b08ac5a
--- /dev/null
+++ b/src/rlharness/rlharness.hpp
@@ -0,0 +1,59 @@
+#pragma once
+
+// v4.0.0 reinforcement-learning harness (10-P0 WP3).
+//
+// Everything here is compiled only when CMake is configured with
+// -DTH08_RL_HARNESS=ON.  The option is OFF by default and the vanilla build is
+// byte-identical to the unmodified portable branch when it is off.
+//
+// Roles (10-P0 §3):
+//   env    - renders, reads pixels back, never forks.
+//   shadow - null device, no window, no GL context; may fork for BRANCH.
+
+#ifdef TH08_RL_HARNESS
+
+#include "inttypes.hpp"
+
+namespace th08
+{
+namespace modern
+{
+namespace rlharness
+{
+// The reconstructed game headers stop at u32 (VC7 compatibility); 64-bit
+// counters and hashes get their own name so they cannot be confused with the
+// game's own typedefs.
+typedef unsigned long long RlU64;
+
+// Protocol version reported by HELLO; bump on any incompatible change.
+const u32 PROTOCOL_VERSION = 1;
+
+// Parses --rl-control / --rl-role out of the process arguments.  On Linux the
+// entry point stores argv in th08::modern::g_arguments because WinMain receives
+// NULL (see linux_runtime.cpp), so this reads those globals.  Returns true when
+// harness mode was requested (the caller then enters Run() instead of the normal
+// WinMain message loop).
+bool ParseCommandLine();
+
+// True once ParseCommandLine() succeeded.
+bool IsActive();
+
+// The button mask the engine should see this frame (bit layout from 03 §3.1).
+u16 CurrentMask();
+void SetMask(u16 mask);
+
+// Blocks on the control pipe, executes commands, returns a process exit code.
+int Run();
+
+// Implemented in main.cpp: advance exactly one logic frame with draw + present,
+// with no frame-rate gate and no frame skipping (the harness never skips).
+// Returns false when the engine asked to exit.
+bool PumpOneFrame();
+
+// Implemented in main.cpp: how many logic frames this process has executed.
+RlU64 FrameCount();
+}
+}
+}
+
+#endif // TH08_RL_HARNESS
