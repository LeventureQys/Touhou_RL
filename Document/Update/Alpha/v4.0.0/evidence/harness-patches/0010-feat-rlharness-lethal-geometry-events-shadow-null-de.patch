+        limit == 0 ? laserCount : (limit < laserCount ? limit : laserCount);
+    const unsigned enemyLimit =
+        limit == 0 ? enemyCount : (limit < enemyCount ? limit : enemyCount);
+
+    static char buffer[HAZARDS_REPLY_CAPACITY];
+    HazardReply reply;
+    reply.data = buffer;
+    reply.capacity = HAZARDS_REPLY_CAPACITY;
+    reply.length = 0;
+    reply.overflow = false;
+
+    reply.Append("OK frames=%llu nb=%u nl=%u ne=%u bullets=",
+                 static_cast<unsigned long long>(FrameCount()), bulletCount, laserCount,
+                 enemyCount);
+    unsigned emitted = 0;
+    for (unsigned slot = 0; slot < 0x601 && emitted < bulletLimit; ++slot)
+    {
+        const Bullet &bullet = g_BulletManager.bullets[slot];
+        if (bullet.state == BULLET_STATE_UNUSED)
+            continue;
+        reply.Append("%s%u:%u:%u:%08x:%08x:%08x:%08x:%08x:%d:%08x:%d", emitted ? "," : "",
+                     slot, static_cast<unsigned>(bullet.state),
+                     static_cast<unsigned>(bullet.color), FloatBits(bullet.position.x),
+                     FloatBits(bullet.position.y), FloatBits(bullet.position.z),
+                     FloatBits(bullet.velocity.x), FloatBits(bullet.velocity.y),
+                     bullet.activeTimer.current, FloatBits(bullet.sprites.collisionSize.x),
+                     static_cast<int>(bullet.collisionDisabled));
+        ++emitted;
+    }
+    reply.Append(" lasers=");
+    emitted = 0;
+    for (unsigned slot = 0; slot < 0x100 && emitted < laserLimit; ++slot)
+    {
+        const Laser &laser = g_BulletManager.lasers[slot];
+        if (!laser.inUse)
+            continue;
+        char row[192];
+        FormatLaserRow(row, sizeof(row), emitted ? "," : "", slot, laser);
+        reply.Append("%s", row);
+        ++emitted;
+    }
+    reply.Append(" enemies=");
+    emitted = 0;
+    for (unsigned slot = 0; slot < 481 && emitted < enemyLimit; ++slot)
+    {
+        const Enemy &enemy = g_EnemyManager.enemies[slot];
+        if ((enemy.flags1 & ENEMY_FLAG_ACTIVE) == 0)
+            continue;
+        reply.Append("%s%u:%08x:%08x:%08x:%08x:%08x:%d:%08x:%08x:%08x:%08x:%08x",
+                     emitted ? "," : "", slot, enemy.flags1, FloatBits(enemy.position.x),
+                     FloatBits(enemy.position.y), FloatBits(enemy.position.z),
+                     static_cast<unsigned>(enemy.life), enemy.timer3318.current,
+                     FloatBits(enemy.worldPosition.x), FloatBits(enemy.worldPosition.y),
+                     FloatBits(enemy.worldPosition.z), FloatBits(enemy.hitboxDimensions.x),
+                     FloatBits(enemy.hitboxDimensions.y));
+        ++emitted;
+    }
+
+    if (reply.overflow)
+    {
+        Reply("ERR hazards-too-large capacity=%llu",
+              static_cast<unsigned long long>(HAZARDS_REPLY_CAPACITY));
+        return;
+    }
+    fwrite(buffer, 1, reply.length, g_out);
+    fputc('\n', g_out);
+    fflush(g_out);
+}
