+// New commands in this block:
+//   PLAYER    self ship hitbox, resources and the per-shot movement speed
+//             table read from the live .sht data (never a constant).
+//   HAZARDS   all bullets + lasers + enemy bodies of the current frame in one
+//             reply, so recording a HazardTape costs one round trip per frame
+//             instead of three paged ones.
+//   EVENTS    the per-frame replay event bitmask (ReplayManager.hpp:213),
+//             which carries REPLAY_FRAME_EVENT_PLAYER_HIT = 0x2.  Read-only,
+//             and deliberately NOT part of the 25 tracked STATE/HASH fields.
+// ---------------------------------------------------------------------------
+
+// The laser hitbox windows of BulletManager.cpp:1096-1142, as one predicate.
+//
+//   LASER_STATE_STARTING (0): the player is tested only once
+//       ``timer >= hitboxStartTime`` (1106-1108);
+//   LASER_STATE_ACTIVE   (1): tested on every update (1117-1121);
+//   LASER_STATE_DESPAWNING (2): tested while ``timer < hitboxEndDelay``
+//       (1140-1142).
+//
+// The timer a row exports is the value the *next* OnUpdate reads: the frame
+// that just ran incremented it after its own test (``laser->timer++``, 1148).
+// ``damageable`` therefore answers "will this laser's hitbox be evaluated in
+// the frame my next action is simulated in", which is the question a planner
+// has to ask, and it is computed here rather than pushed onto every client.
+static bool LaserDamageable(const Laser &laser)
+{
+    switch (laser.state)
+    {
+    case LASER_STATE_STARTING:
+        return laser.timer.current >= laser.hitboxStartTime;
+    case LASER_STATE_ACTIVE:
+        return true;
+    case LASER_STATE_DESPAWNING:
+        return laser.timer.current < laser.hitboxEndDelay;
+    default:
+        return false;
+    }
+}
