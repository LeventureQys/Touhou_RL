+// EVENTS: the per-frame replay event bitmask.
+//
+// ReplayManager::frameEventFlags (ReplayManager.hpp:213) is a u16 that gameplay
+// systems OR into as the frame runs (Player.cpp:329 sets
+// REPLAY_FRAME_EVENT_PLAYER_HIT = 0x2) and that
+// ReplayManager::CaptureFrameSyncState clears at the start of the next frame
+// (ReplayManager.cpp:297).  The clearing callback is registered in record mode
+// as well as playback mode (ReplayManager.cpp:240-243), so a normally started
+// stage accumulates here too; after STEP, the value is the last advanced
+// frame's events.  Reading it does not advance time, draw, or touch the RNG,
+// and it is deliberately NOT one of the 25 tracked STATE/HASH fields.
+//
+// g_ReplayManager is NULL before a stage registers it and is reset to NULL by
+// DeleteReplayManager (ReplayManager.cpp:743).  In that state there is no flag
+// word to report, so the command fails closed with ERR events-unavailable
+// rather than fabricating 0, which would read as "no player hit".
+void HandleEvents()
+{
+    if (g_ReplayManager == NULL)
+    {
+        Reply("ERR events-unavailable g_replaymanager=0");
+        return;
+    }
+    // EXP-P2-007: append the harness-derived STAGE_CLEAR bit.  The engine's own
+    // u16 (ReplayManager frameEventFlags, ReplayManager.hpp:161-172) is reported
+    // unchanged in the low bits; 0x0080 is the one hole in that enum
+    // (0x0001/2/4/20/40/100/200/400/800/1000/2000 are taken - note 0x0100 is
+    // REPLAY_FRAME_EVENT_PAUSE_RECORDED), so the harness bit cannot collide.
+    const unsigned events =
+        static_cast<unsigned>(g_ReplayManager->frameEventFlags) |
+        static_cast<unsigned>(g_stageClearScreen != 0 ? 0x0080u : 0u);
+    Reply("OK frames=%llu frameEventFlags=%04x stageClear=%u stageClearEdge=%u "
+          "stageClearEdgeFrame=%llu stageClearScreenState=%d stageClearSeq=%u",
+          static_cast<unsigned long long>(FrameCount()), events,
+          static_cast<unsigned>(g_stageClearScreen),
+          g_stageClearEdgeSeen ? 1u : 0u,
+          static_cast<unsigned long long>(g_stageClearEdgeSeen ? g_stageClearEdgeFrame : 0u),
+          g_Gui.impl != NULL ? static_cast<int>(g_Gui.impl->stageClearScreenState) : -1,
+          static_cast<unsigned>(g_GameManager.flags.stageClearSequenceActive));
+}
