+++ b/src/rlharness/null_device.cpp
@@ -0,0 +1,17 @@
+#include "null_device.hpp"
+#ifdef TH08_RL_HARNESS
+#include <stdio.h>
+#include <stdlib.h>
+namespace th08 { namespace modern { namespace rlharness {
+bool NullDevicePreflight(char *reason, unsigned reasonSize) {
+    if (reason != NULL && reasonSize != 0) reason[0] = 0;
+    const char *display = getenv("DISPLAY");
+    if (display != NULL && display[0] != 0) {
+        if (reason != NULL && reasonSize != 0) snprintf(reason, reasonSize, "DISPLAY must be empty");
+        return false;
+    }
+    if (reason != NULL && reasonSize != 0) snprintf(reason, reasonSize, "null-device preflight: no SDL/GL/window/audio");
+    return true;
+}
+}}}
+#endif
