+// The control channel is unbuffered, so one fprintf per hazard would cost one
+// write syscall per hazard.  A 600-bullet frame is assembled here and written
+// with a single fwrite; the fixed capacity is also the length guard.
+struct HazardReply
+{
+    char *data;
+    size_t capacity;
+    size_t length;
+    bool overflow;
+
+    void Append(const char *format, ...)
+    {
+        if (this->overflow)
+            return;
+        if (this->length >= this->capacity)
+        {
+            this->overflow = true;
+            return;
+        }
+        va_list args;
+        va_start(args, format);
+        const int written =
+            vsnprintf(this->data + this->length, this->capacity - this->length, format, args);
+        va_end(args);
+        if (written < 0 || static_cast<size_t>(written) >= this->capacity - this->length)
+        {
+            this->overflow = true;
+            return;
+        }
+        this->length += static_cast<size_t>(written);
+    }
+};
