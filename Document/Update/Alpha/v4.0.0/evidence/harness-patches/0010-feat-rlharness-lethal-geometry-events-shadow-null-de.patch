+// ---------------------------------------------------------------------------
+// Optional asynchronous backbuffer readback (PBO double buffer).
+//
+// TH08_ASYNC_READBACK=1 pipelines the D3D8-layer readback: glReadPixels(...,
+// NULL) records the frame into a GL_PIXEL_PACK_BUFFER and that buffer is mapped
+// one frame later, so the caller stops waiting for the rasteriser to drain.
+// Pixel content and the public interface are unchanged; only the latency
+// changes (the surface then holds the previous frame).  With the variable unset
+// the synchronous path runs verbatim, i.e. default behaviour is byte-for-byte
+// identical to the pre-patch engine.
+typedef void (APIENTRY *GenBuffersFunction)(GLsizei, GLuint *);
+typedef void (APIENTRY *BindBufferFunction)(GLenum, GLuint);
+typedef void (APIENTRY *BufferDataFunction)(GLenum, GLsizeiptr, const void *, GLenum);
+typedef void *(APIENTRY *MapBufferFunction)(GLenum, GLenum);
+typedef GLboolean (APIENTRY *UnmapBufferFunction)(GLenum);
+typedef void (APIENTRY *DeleteBuffersFunction)(GLsizei, const GLuint *);
+
+struct PixelBufferApi
+{
+    PixelBufferApi()
+        : genBuffers(NULL), bindBuffer(NULL), bufferData(NULL), mapBuffer(NULL),
+          unmapBuffer(NULL), deleteBuffers(NULL), ready(false)
+    {
+    }
+
+    void *Load(const char *coreName, const char *extensionName)
+    {
+        void *procedure = SDL_GL_GetProcAddress(coreName);
+        return procedure != NULL ? procedure : SDL_GL_GetProcAddress(extensionName);
+    }
+
+    bool Initialize()
+    {
+        if (ready) return true;
+        genBuffers = reinterpret_cast<GenBuffersFunction>(Load("glGenBuffers", "glGenBuffersARB"));
+        bindBuffer = reinterpret_cast<BindBufferFunction>(Load("glBindBuffer", "glBindBufferARB"));
+        bufferData = reinterpret_cast<BufferDataFunction>(Load("glBufferData", "glBufferDataARB"));
+        mapBuffer = reinterpret_cast<MapBufferFunction>(Load("glMapBuffer", "glMapBufferARB"));
+        unmapBuffer = reinterpret_cast<UnmapBufferFunction>(Load("glUnmapBuffer", "glUnmapBufferARB"));
+        deleteBuffers = reinterpret_cast<DeleteBuffersFunction>(Load("glDeleteBuffers", "glDeleteBuffersARB"));
+        ready = genBuffers != NULL && bindBuffer != NULL && bufferData != NULL &&
+                mapBuffer != NULL && unmapBuffer != NULL && deleteBuffers != NULL;
+        return ready;
+    }
+
+    GenBuffersFunction genBuffers;
+    BindBufferFunction bindBuffer;
+    BufferDataFunction bufferData;
+    MapBufferFunction mapBuffer;
+    UnmapBufferFunction unmapBuffer;
+    DeleteBuffersFunction deleteBuffers;
+    bool ready;
+};
+
+PixelBufferApi g_pixelBufferApi;
+
+bool AsyncReadbackEnabled()
+{
+    static int cached = -1;   // -1 = unprobed, 0 = off, 1 = on
+    if (cached < 0)
+    {
+        const char *value = getenv("TH08_ASYNC_READBACK");
+        cached = value != NULL && value[0] != '\0' && value[0] != '0' ? 1 : 0;
+    }
+    return cached != 0;
+}
