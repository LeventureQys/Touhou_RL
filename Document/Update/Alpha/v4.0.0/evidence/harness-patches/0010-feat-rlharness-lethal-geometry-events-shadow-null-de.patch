+static void FormatLaserRow(char *out, size_t capacity, const char *prefix, unsigned slot,
+                           const Laser &laser)
+{
+    snprintf(out, capacity,
+             "%s%u:%u:%08x:%08x:%08x:%08x:%08x:%08x:%08x:%08x:%d:%d"
+             ":%d:%d:%d:%d:%d:%d",
+             prefix, slot, static_cast<unsigned>(laser.state),
+             FloatBits(laser.position.x), FloatBits(laser.position.y),
+             FloatBits(laser.position.z), FloatBits(laser.angle),
+             FloatBits(laser.startOffset), FloatBits(laser.endOffset),
+             FloatBits(laser.currentWidth), FloatBits(laser.width),
+             static_cast<int>(laser.timer.current), static_cast<int>(laser.inUse),
+             static_cast<int>(laser.startTime), static_cast<int>(laser.hitboxStartTime),
+             static_cast<int>(laser.duration), static_cast<int>(laser.despawnDuration),
+             static_cast<int>(laser.hitboxEndDelay),
