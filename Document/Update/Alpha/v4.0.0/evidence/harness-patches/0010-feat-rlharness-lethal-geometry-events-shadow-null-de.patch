+bool RebindControlFds(int inFd, int outFd)
+{
+    FILE *input = fdopen(inFd, "r");
+    if (!input) { close(inFd); close(outFd); return false; }
+    FILE *output = fdopen(outFd, "w");
+    if (!output) { fclose(input); close(outFd); return false; }
+    // The forked child must not retain either end of its caller's channel.
+    if (g_in) fclose(g_in);
+    if (g_out) fclose(g_out);
+    g_in = input;
+    g_out = output;
+    setvbuf(g_out, NULL, _IONBF, 0);
+    return true;
+}
