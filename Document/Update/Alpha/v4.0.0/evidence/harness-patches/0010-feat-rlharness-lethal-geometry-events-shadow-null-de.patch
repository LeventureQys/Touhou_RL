diff --git a/src/rlharness/fork.cpp b/src/rlharness/fork.cpp
new file mode 100755
index 0000000..9934145
--- /dev/null
+++ b/src/rlharness/fork.cpp
@@ -0,0 +1,396 @@
+// WP5: only a null-device, single-threaded shadow may copy the live game state.
+// No serialization or synthetic state: fork() copies the actual engine address space.
+#ifdef TH08_RL_HARNESS
+#include "rlharness.hpp"
+#include "Supervisor.hpp"
+#include "GameManager.hpp"
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/types.h>
+#include <signal.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+
+namespace th08 { namespace modern { namespace rlharness {
+namespace {
+int ThreadCount() {
+    DIR *dir = opendir("/proc/self/task");
+    if (!dir) return -1;
+    int count = 0;
+    struct dirent *entry;
+    while ((entry = readdir(dir)) != NULL)
+        if (entry->d_name[0] != '.') ++count;
+    closedir(dir);
+    return count;
+}
+bool Ready() {
+    return IsShadowRole() && ThreadCount() == 1 &&
+        g_Supervisor.runningSubthreadHandle == NULL &&
+        g_GameManager.gameplaySetupState == GAMEPLAY_SETUP_COMPLETE &&
+        g_GameManager.globals != NULL;
+}
+unsigned long long Micros() {
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return (unsigned long long)now.tv_sec * 1000000ULL + now.tv_nsec / 1000ULL;
+}
+// No child shares parent's protocol pipes. Results go through a dedicated pipe.
+bool ReadAll(int fd, void *data, size_t size) {
+    unsigned char *out = (unsigned char *)data;
+    while (size) {
+        ssize_t count = read(fd, out, size);
+        if (count <= 0) return false;
+        out += count; size -= (size_t)count;
+    }
+    return true;
+}
+struct BranchResult {
+    unsigned advanced;
+    unsigned long long hashes[300];
+    unsigned long long elapsed;
+};
+}
+
+// BRANCH <mask> <frames>: one actual OS fork, advance the real engine in the
+// child and return every actual tracked-state hash without advancing the parent.
+void HandleBranch(char *args) {
+    if (!Ready()) {
+        printf("ERR fork-unsafe role=shadow-required threads=%d\n", ThreadCount());
+        fflush(stdout);
+        return;
+    }
+    unsigned mask = 0, frames = 0;
+    char extra = 0;
+    if (sscanf(args, "%u %u %c", &mask, &frames, &extra) != 2 ||
+        mask > 0xFFFF || frames == 0 || frames > 300) {
+        printf("ERR branch-usage BRANCH <mask> <frames<=300>\n"); fflush(stdout); return;
+    }
+    int pipefd[2];
+    if (pipe(pipefd) != 0) { printf("ERR branch-pipe\n"); fflush(stdout); return; }
+    fflush(NULL);
+    unsigned long long start = Micros();
+    pid_t pid = fork();
+    if (pid < 0) {
+        close(pipefd[0]); close(pipefd[1]);
+        printf("ERR branch-fork errno=%d\n", errno); fflush(stdout); return;
+    }
+    if (pid == 0) {
+        close(pipefd[0]);
+        // Forking a GL/SDL process is forbidden by Ready(); child must never
+        // return into the parent's control loop, nor flush atexit handlers.
+        BranchResult result = {};
+        SetMask((u16)mask);
+        const unsigned long long begin = Micros();
+        for (unsigned i=0; i<frames; ++i) {
+            if (!PumpOneFrame()) break;
+            result.hashes[result.advanced++] = CurrentStateHash();
+        }
+        result.elapsed = Micros() - begin;
+        const unsigned char *bytes = (const unsigned char *)&result;
+        size_t remaining = sizeof(result);
+        while (remaining) {
+            ssize_t written = write(pipefd[1], bytes, remaining);
+            if (written <= 0) _exit(71);
+            remaining -= (size_t)written; bytes += written;
+        }
+        close(pipefd[1]);
+        _exit(0);
+    }
+    close(pipefd[1]);
+    BranchResult result = {};
+    bool received = ReadAll(pipefd[0], &result, sizeof(result));
+    close(pipefd[0]);
+    int status = 0;
+    bool reaped = waitpid(pid, &status, 0) == pid;
+    if (!received || !reaped || !WIFEXITED(status) || WEXITSTATUS(status) != 0 || result.advanced > 300) {
+        printf("ERR branch-child pid=%ld status=%d\n", (long)pid, status); fflush(stdout); return;
+    }
+    unsigned long long forkMicros = Micros() - start;
+    // Each hash is exactly sixteen hex digits; 300 hashes + header stay below
+    // 8192 bytes, and the caller receives the actual per-frame game trace.
+    printf("OK branch=1 pid=%ld parent_frame=%llu advanced=%u fork_us=%llu child_us=%llu hash=%016llx trace=",
+           (long)pid, (unsigned long long)FrameCount(), result.advanced,
+           forkMicros, result.elapsed,
+           result.advanced ? result.hashes[result.advanced-1] : CurrentStateHash());
+    for (unsigned i = 0; i < result.advanced; ++i)
+        printf("%016llx", result.hashes[i]);
+    putchar('\n');
+    fflush(stdout);
+}
+namespace {
+// One parked process owns every child it forks and the child's private pipes.
+struct ParkedTemplate { pid_t pid; int command; unsigned long long id; };
+ParkedTemplate g_template = { -1, -1, 0 };
+unsigned long long g_nextTemplate = 0;
+struct Spawned { pid_t pid; int input; int output; unsigned long long id; };
+Spawned g_children[32] = {};
+unsigned long long g_nextChild = 0;
+bool WriteAll(int fd, const void *data, size_t size) {
+    const unsigned char *bytes = static_cast<const unsigned char *>(data);
+    while (size) {
+        ssize_t n = write(fd, bytes, size);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) return false;
+        bytes += n; size -= static_cast<size_t>(n);
+    }
+    return true;
+}
+bool ReadLine(int fd, char *line, size_t capacity) {
+    size_t length = 0;
+    while (length + 1 < capacity) {
+        char ch;
+        ssize_t n = read(fd, &ch, 1);
+        if (n < 0 && errno == EINTR) continue;
+        if (n != 1) return false;
+        line[length++] = ch;
+        if (ch == '\n') { line[length] = 0; return true; }
+    }
+    return false;
+}
+
+// CHILD replies are whole protocol lines.  Most are tens of bytes, but HAZARDS
+// is one line of up to 256 KiB (HAZARDS_REPLY_CAPACITY), so forwarding through
+// a fixed 4 KiB line buffer would truncate a real answer into ERR child-read.
+// Stream the line chunk by chunk instead: the child can block on a full pipe
+// and this reader drains it.
+bool ForwardLine(int from, int to) {
+    char buffer[8192];
+    while (true) {
+        ssize_t n = read(from, buffer, sizeof(buffer));
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) return false;
+        const char *newline =
+            static_cast<const char *>(memchr(buffer, '\n', static_cast<size_t>(n)));
+        const size_t chunk =
+            newline ? static_cast<size_t>(newline - buffer) + 1 : static_cast<size_t>(n);
+        if (!WriteAll(to, buffer, chunk)) return false;
+        if (newline) return true;
+    }
+}
+void ReleaseTemplate() {
+    if (g_template.pid <= 0) return;
+    close(g_template.command);
+    int status = 0;
+    while (waitpid(g_template.pid, &status, 0) < 0 && errno == EINTR) {}
+    g_template.pid = -1; g_template.command = -1; g_template.id = 0;
+}
+void TemplateLoop(int control) {
+    signal(SIGPIPE, SIG_IGN); // A dead worker must not kill its template.
+    char line[4096], answer[4096];
+    while (ReadLine(control, line, sizeof(line))) {
+        if (strcmp(line, "SPAWN\n") == 0) {
+            int toChild[2], fromChild[2];
+            if (pipe(toChild) != 0) { WriteAll(control, "ERR spawn-pipe\n", 15); continue; }
+            if (pipe(fromChild) != 0) {
+                close(toChild[0]); close(toChild[1]);
+                WriteAll(control, "ERR spawn-pipe\n", 15); continue;
+            }
+            unsigned slot = 0;
+            while (slot < 32 && g_children[slot].pid > 0) ++slot;
+            if (slot == 32) {
+                close(toChild[0]); close(toChild[1]); close(fromChild[0]); close(fromChild[1]);
+                WriteAll(control, "ERR spawn-capacity\n", 19); continue;
+            }
+            fflush(NULL);
+            pid_t pid = fork();
+            if (pid == 0) {
+                close(control);
+                close(toChild[1]); close(fromChild[0]);
+                for (unsigned i = 0; i < 32; ++i) if (g_children[i].pid > 0) {
+                    close(g_children[i].input); close(g_children[i].output);
+                }
+                // No inherited caller channel survives in the spawned process.
+                if (!RebindControlFds(toChild[0], fromChild[1])) _exit(74);
+                _exit(Run());
+            }
+            close(toChild[0]); close(fromChild[1]);
+            if (pid < 0) {
+                close(toChild[1]); close(fromChild[0]);
+                WriteAll(control, "ERR spawn-fork\n", 15); continue;
+            }
+            Spawned &child = g_children[slot];
+            child.pid = pid; child.input = toChild[1]; child.output = fromChild[0];
+            child.id = ++g_nextChild;
+            snprintf(answer, sizeof(answer), "OK spawned=1 pid=%ld handle=%llu\n",
+                     (long)pid, child.id);
+            WriteAll(control, answer, strlen(answer));
+        } else if (strncmp(line, "CHILD ", 6) == 0) {
+            unsigned long long id = 0;
+            char *cmd = strchr(line + 6, ' ');
+            if (!cmd || sscanf(line + 6, "%llu", &id) != 1) {
+                WriteAll(control, "ERR child-usage\n", 16); continue;
+            }
+            unsigned slot = 0;
+            while (slot < 32 && (g_children[slot].pid <= 0 || g_children[slot].id != id)) ++slot;
+            if (slot == 32) { WriteAll(control, "ERR child-handle\n", 17); continue; }
+            Spawned &child = g_children[slot];
+            ++cmd;
+            if (!WriteAll(child.input, cmd, strlen(cmd))) {
+                WriteAll(control, "ERR child-write\n", 16); continue;
+            }
+            struct pollfd pfd = { child.output, POLLIN, 0 };
+            int ready;
+            do { ready = poll(&pfd, 1, 30000); } while (ready < 0 && errno == EINTR);
+            if (ready <= 0 || !ForwardLine(child.output, control)) {
+                WriteAll(control, "ERR child-read\n", 15); continue;
+            }
+            if (strcmp(cmd, "QUIT\n") == 0) {
+                close(child.input); close(child.output);
+                int status = 0;
+                while (waitpid(child.pid, &status, 0) < 0 && errno == EINTR) {}
+                child.pid = -1;
+            }
+        } else WriteAll(control, "ERR template-command\n", 21);
+    }
+    for (unsigned i = 0; i < 32; ++i) if (g_children[i].pid > 0) {
+        close(g_children[i].input); close(g_children[i].output);
+        kill(g_children[i].pid, SIGTERM);
+        int status = 0;
+        while (waitpid(g_children[i].pid, &status, 0) < 0 && errno == EINTR) {}
+    }
+    close(control);
+}
+}
+void HandlePark() {
+    const char *display = getenv("DISPLAY");
+    if (!Ready() || (display && *display) ||
+        g_Supervisor.startupThreadState != SupervisorStartupThreadState_Idle ||
+        g_Supervisor.subthreadActive || !g_Supervisor.d3dDevice) {
+        printf("ERR park-unsafe role=shadow-required threads=%d setup=%u null_device=%d\n",
+               ThreadCount(), static_cast<unsigned>(g_GameManager.gameplaySetupState),
+               IsShadowRole() && (!display || !*display) && g_Supervisor.d3dDevice != NULL ? 1 : 0);
+        fflush(stdout); return;
+    }
+    int command[2], ready[2];
+    if (socketpair(AF_UNIX, SOCK_STREAM, 0, command) != 0) {
+        printf("ERR park-pipe errno=%d\n", errno); fflush(stdout); return;
+    }
+    if (pipe(ready) != 0) {
+        int error = errno; close(command[0]); close(command[1]);
+        printf("ERR park-pipe errno=%d\n", error); fflush(stdout); return;
+    }
+    fflush(NULL);
+    pid_t pid = fork();
+    if (pid < 0) {
+        int error = errno;
+        close(command[0]); close(command[1]); close(ready[0]); close(ready[1]);
+        printf("ERR park-fork errno=%d\n", error); fflush(stdout); return;
+    }
+    if (pid == 0) {
+        close(command[0]); close(ready[0]);
+        if (g_template.pid > 0) close(g_template.command);
+        g_template.pid = -1; g_template.command = -1; g_template.id = 0;
+        int nullin = open("/dev/null", O_RDONLY);
+        int nullout = open("/dev/null", O_WRONLY);
+        if (nullin < 0 || nullout < 0 || !RebindControlFds(nullin, nullout)) _exit(73);
+        int devnull = open("/dev/null", O_WRONLY);
+        if (devnull >= 0) { dup2(devnull, STDOUT_FILENO); if (devnull != STDOUT_FILENO) close(devnull); }
+        const unsigned char ack = 0xA5;
+        if (!WriteAll(ready[1], &ack, 1)) _exit(72);
+        close(ready[1]);
+        TemplateLoop(command[1]);
+        _exit(0);
+    }
+    close(command[1]); close(ready[1]);
+    unsigned char ack = 0;
+    bool acknowledged = ReadAll(ready[0], &ack, 1) && ack == 0xA5;
+    close(ready[0]);
+    if (!acknowledged) {
+        close(command[0]); int status = 0;
+        while (waitpid(pid, &status, 0) < 0 && errno == EINTR) {}
+        printf("ERR park-child pid=%ld\n", (long)pid); fflush(stdout); return;
+    }
+    ReleaseTemplate();
+    static bool cleanupRegistered = false;
+    if (!cleanupRegistered) {
+        if (atexit(ReleaseTemplate) != 0) {
+            close(command[0]); int status = 0;
+            while (waitpid(pid, &status, 0) < 0 && errno == EINTR) {}
+            printf("ERR park-cleanup-registration\n"); fflush(stdout); return;
+        }
+        cleanupRegistered = true;
+    }
+    g_template.pid = pid; g_template.command = command[0];
+    g_template.id = ++g_nextTemplate;
+    printf("OK park=1 template=%llu pid=%ld frame=%llu\n", g_template.id,
+           (long)pid, static_cast<unsigned long long>(FrameCount()));
+    fflush(stdout);
+}
+void HandleSpawn(char *args) {
+    if (g_template.pid <= 0 || kill(g_template.pid, 0) != 0) {
+        printf("ERR spawn-no-live-template\n"); fflush(stdout); return;
+    }
+    unsigned long long id = 0;
+    char extra = 0;
+    if (sscanf(args, "%llu %c", &id, &extra) != 1 || id != g_template.id) {
+        printf("ERR spawn-template expected=%llu\n", g_template.id); fflush(stdout); return;
+    }
+    char result[4096];
+    if (!WriteAll(g_template.command, "SPAWN\n", 6) ||
+        !ReadLine(g_template.command, result, sizeof(result))) {
+        printf("ERR spawn-template-channel\n"); fflush(stdout); return;
+    }
+    result[strcspn(result, "\r\n")] = 0;
+    printf("%s template=%llu\n", result, g_template.id); fflush(stdout);
+}
+
+// Commands a forked child may answer on behalf of its caller.  HAZARDS, PLAYER,
+// BULLETS, LASERS, ENEMIES and EVENTS are read-only in rlharness.cpp: each one
+// reads engine state and writes one reply without advancing a frame, drawing,
+// or touching the RNG, and the child inherits the parent's g_resetReady /
+// g_GameManager.globals at SPAWN time (the template is forked from the parent
+// after PARK), so it can answer them with the parent's semantics.  The child
+// validates its own arguments and answers ERR <cmd>-usage, which is an explicit
+// refusal and not a silent failure.
+bool ChildReadOnlyCommand(const char *cmd) {
+    static const char *const exact[] = {
+        "HELLO", "HASH", "QUIT", "DEBUG", "FRAME", "PING", "STATE",
+        "PLAYER", "EVENTS", "HAZARDS",
+    };
+    for (unsigned i = 0; i < sizeof(exact) / sizeof(exact[0]); ++i) {
+        if (strcmp(cmd, exact[i]) == 0) return true;
+    }
+    static const char *const withArgs[] = {"BULLETS ", "LASERS ", "ENEMIES ", "HAZARDS "};
+    for (unsigned i = 0; i < sizeof(withArgs) / sizeof(withArgs[0]); ++i) {
+        const size_t length = strlen(withArgs[i]);
+        if (strncmp(cmd, withArgs[i], length) == 0) return true;
+    }
+    return false;
+}
+
+void HandleChild(char *args) {
+    if (g_template.pid <= 0 || kill(g_template.pid, 0) != 0) {
+        printf("ERR child-no-live-template\n"); fflush(stdout); return;
+    }
+    unsigned long long id = 0;
+    char *command = strchr(args, ' ');
+    if (sscanf(args, "%llu", &id) != 1 || !command || id == 0 ||
+        strlen(command + 1) > 3800 || strchr(command + 1, '\n')) {
+        printf("ERR child-usage CHILD <handle> <command>\n"); fflush(stdout); return;
+    }
+    const char *cmd = command + 1;
+    const bool readOnly = ChildReadOnlyCommand(cmd);
+    unsigned mask = 0, frames = 0;
+    char extra = 0;
+    if (!readOnly && (sscanf(cmd, "STEP %u %u %c", &mask, &frames, &extra) != 2 ||
+                      strncmp(cmd, "STEP ", 5) != 0 || mask > 65535 || frames > 100000)) {
+        printf("ERR child-command\n"); fflush(stdout); return;
+    }
+    char request[4096];
+    snprintf(request, sizeof(request), "CHILD %llu %s\n", id, command + 1);
+    fflush(stdout);
+    if (!WriteAll(g_template.command, request, strlen(request)) ||
+        !ForwardLine(g_template.command, STDOUT_FILENO)) {
+        printf("ERR child-template-channel\n"); fflush(stdout); return;
+    }
+    fflush(stdout);
+}
+}}}
+#endif
