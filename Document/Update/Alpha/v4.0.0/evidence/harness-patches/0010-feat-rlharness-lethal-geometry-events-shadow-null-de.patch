+// HUD: the counters the in-game HUD actually draws, read-only.
+//
+// Why this exists (EXP-P2-004 §5.2, EXP-P2-005): the 25 tracked STATE/HASH
+// fields carry `globals->score` (the authoritative total), but Gui.cpp:1299
+// draws `globals->displayScore`, which GameManager.cpp:535-557 scrolls toward
+// the authoritative value every frame.  A pixel reader therefore cannot
+// recover `score` on the frames where the counter is still rolling; only
+// `displayScore` is in the picture.  This command exports both, so a label
+// consumer can pick the one the pixels actually contain.
+//
+// Everything here is a read of existing engine state: it does not advance
+// time, draw, draw from the RNG, or touch any of the 25 tracked fields, so it
+// is deliberately NOT part of HASH/STATE and cannot change determinism.
+//
+// Field semantics (all values are the engine's own, no rescaling):
+//   displayScore      ZunGlobals::displayScore  (Global.hpp:0x0) - drawn by Gui.cpp:1299
+//   globalsScore      ZunGlobals::score         (Global.hpp:0x8) - the STATE f4 field
+//   lives             (int)ZunGlobals::livesRemaining   (f32, 0x74)
+//   bombs             (int)ZunGlobals::bombsRemaining   (f32, 0x80)
+//   power             (int)ZunGlobals::playerPower      (f32, 0x98)
+//   graze             ZunGlobals::graze                 (i32, 0xC)   - Gui.cpp:1317
+//   point             ZunGlobals::pointItemsCollected   (i32, 0x30)  - Gui.cpp:1322
+//   time              ZunGlobals::currentTimeOrbs       (i32, 0x3C)  - Gui.cpp:1334 via GetTimeOrbs()
+//   gameOverFlag      g_GameManager.showRetryMenu ? 1 : 0 - the same bit STEP reports as game_over=
+//   displayAge        globalsScore > displayScore ? globalsScore - displayScore : 0
+//                     (how far the drawn counter still lags, in points)
+//   displayStale      consecutive STEP frames with an unchanged displayScore
+//   scoreDisplayStep  ZunGlobals::scoreDisplayStep (0x10), the per-frame step the
+//                     roll is currently using; 0 once the counter has settled
+//
+// Appended-only reply shape, so a v4.0.0 client that parses the prefix keeps
+// working; the required ten fields are in the documented order.
+void HandleHud()
+{
+    if (!g_GameManager.globals)
+    {
+        Reply("ERR hud-not-ready reset-required");
+        return;
+    }
+    const ZunGlobals &globals = *g_GameManager.globals;
+    const u32 display = globals.displayScore;
+    const u32 score = globals.score;
+    const u32 age = score > display ? score - display : 0u;
+    Reply("OK frames=%llu displayScore=%u globalsScore=%u lives=%d bombs=%d power=%u "
+          "graze=%d point=%d time=%d gameOverFlag=%u displayAge=%u displayStale=%u "
+          "scoreDisplayStep=%u",
+          static_cast<unsigned long long>(FrameCount()), display, score,
+          static_cast<int>(globals.livesRemaining),
+          static_cast<int>(globals.bombsRemaining),
+          static_cast<unsigned>(globals.playerPower), globals.graze,
+          globals.pointItemsCollected, globals.currentTimeOrbs,
+          g_GameManager.showRetryMenu ? 1u : 0u, age, g_displayStaleFrames,
+          globals.scoreDisplayStep);
+}
