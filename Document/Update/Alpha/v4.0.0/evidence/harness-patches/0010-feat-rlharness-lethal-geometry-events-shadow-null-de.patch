+    // The pre-patch behaviour, kept verbatim for the default (sync) path.
+    void ReadBackbufferSynchronous()
+    {
+        FlushBackbuffer();
+        std::vector<BYTE> rgba(width * height * 4);
+        glReadPixels(0, 0, width, height, GL_RGBA, GL_UNSIGNED_BYTE, &rgba[0]);
+        EncodeFromRgba(&rgba[0]);
+        dirty = false;
+    }
+    bool AsyncBuffersReady()
+    {
+        if (asyncBuffers[0] != 0 && asyncBuffers[1] != 0) return true;
+        if (!g_pixelBufferApi.Initialize())
+        {
+            fprintf(stderr, "th08 async readback: PBO entry points unavailable\n");
+            return false;
+        }
+        g_pixelBufferApi.genBuffers(2, asyncBuffers);
+        return asyncBuffers[0] != 0 && asyncBuffers[1] != 0;
+    }
+    // Map the PBO filled by the *previous* frame and turn it into surface pixels.
+    void CompleteAsyncRead()
+    {
+        if (!asyncPending) return;
+        asyncPending = false;
+        g_pixelBufferApi.bindBuffer(GL_PIXEL_PACK_BUFFER, asyncBuffers[asyncSlot]);
+        const GLvoid *mapped = g_pixelBufferApi.mapBuffer(GL_PIXEL_PACK_BUFFER, GL_READ_ONLY);
+        if (mapped != NULL)
+        {
+            EncodeFromRgba(static_cast<const BYTE *>(mapped));
+            g_pixelBufferApi.unmapBuffer(GL_PIXEL_PACK_BUFFER);
+        }
+        else
+        {
+            asyncUnavailable = true;   // never publish stale pixels silently
+        }
+        g_pixelBufferApi.bindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+    }
+    // Record this frame into the other PBO without waiting for the rasteriser.
+    void IssueAsyncRead()
+    {
+        asyncSlot ^= 1;
+        const GLsizeiptr byteCount =
+            static_cast<GLsizeiptr>(width) * static_cast<GLsizeiptr>(height) * 4;
+        GLint previousAlignment = 4;
+        g_pixelBufferApi.bindBuffer(GL_PIXEL_PACK_BUFFER, asyncBuffers[asyncSlot]);
+        g_pixelBufferApi.bufferData(GL_PIXEL_PACK_BUFFER, byteCount, NULL, GL_STREAM_READ);
+        glGetIntegerv(GL_PACK_ALIGNMENT, &previousAlignment);
+        glPixelStorei(GL_PACK_ALIGNMENT, 1);
+        glReadPixels(0, 0, width, height, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+        glPixelStorei(GL_PACK_ALIGNMENT, previousAlignment);
+        g_pixelBufferApi.bindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+        asyncPending = true;
+    }
+    void ReadBackbuffer()
+    {
+        if (!backbuffer || width == 0 || height == 0) return;
+        if (g_linuxNullDevice) { dirty = false; return; }
+        static bool announcedSync = false;
+        if (!AsyncReadbackEnabled() || asyncUnavailable)
+        {
+            if (!announcedSync)
+            {
+                announcedSync = true;
+                fprintf(stderr, "th08 async readback: sync path active (enabled=%d unavailable=%d)\n",
+                        AsyncReadbackEnabled() ? 1 : 0, asyncUnavailable ? 1 : 0);
+            }
+            ReadBackbufferSynchronous();
+            return;
+        }
+        {
+            static bool announcedAsync = false;
+            if (!announcedAsync)
+            {
+                announcedAsync = true;
+                fprintf(stderr, "th08 async readback: PBO double buffer active\n");
+            }
+        }
+        if (!AsyncBuffersReady())
+        {
+            asyncUnavailable = true;   // no PBO support: fall back for good
+            ReadBackbufferSynchronous();
+            return;
+        }
+        CompleteAsyncRead();   // one-frame-delayed pixels of the previous read
+        FlushBackbuffer();     // upload the current CPU-side backbuffer if dirty
+        IssueAsyncRead();      // returns immediately; the driver copies in the background
         dirty = false;
     }
     void FlushBackbuffer()
     {
         if (!backbuffer || !dirty || width == 0 || height == 0) return;
+        if (g_linuxNullDevice) { dirty = false; return; }
         std::vector<BYTE> rgba(width * height * 4);
         const UINT bytes = BytesPerPixel(format);
         for (UINT y = 0; y < height; ++y)
