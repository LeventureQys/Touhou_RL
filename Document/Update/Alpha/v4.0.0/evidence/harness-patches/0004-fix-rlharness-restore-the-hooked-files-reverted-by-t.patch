From e151bcbcde78725d208523682681598d4dd68dae Mon Sep 17 00:00:00 2001
From: root <root@ubuntu.localdomain>
Date: Sat, 7 Nov 2026 22:16:01 +0800
Subject: [PATCH 04/10] fix(rlharness): restore the hooked files reverted by
 the previous commit

The DEBUG commit rewound CMakeLists.txt, src/main.cpp, src/Global.cpp and
src/GameManager.cpp to bcddaa2.  Cause: build.sh resets those files to the base
commit with `git checkout bcddaa2 -- <files>`, which writes both the worktree
and the index; re-applying the patches afterwards only touched the worktree, so
the commit captured the base versions.

build.sh is changed to reset only the worktree (`git checkout bcddaa2 --` then
`git reset --` is not enough either) - see the accompanying note.  This commit
restores the four files to their patched content.
---
 CMakeLists.txt      | 18 ++++++++++++
 src/GameManager.cpp |  6 ++++
 src/Global.cpp      |  9 ++++++
 src/main.cpp        | 71 +++++++++++++++++++++++++++++++++++++++++++++
 4 files changed, 104 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 8602702..c5b4c4c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -255,3 +255,21 @@ else()
 endif()
 
 set_target_properties(th08-modern PROPERTIES OUTPUT_NAME "th08-modern")
+
+option(TH08_RL_HARNESS "Enable the v4.0.0 reinforcement-learning harness" OFF)
+if(TH08_RL_HARNESS)
+    target_sources(th08-modern PRIVATE src/rlharness/rlharness.cpp)
+    # The harness needs Rng::ReplayTraceGenerationCount() (field 15 of the 25
+    # tracked fields), which lives behind TH08_ENABLE_REPLAY_TRACE.  So the
+    # harness build turns that on too; its recorder stays inert unless
+    # TH08_REPLAY_TRACE_REFERENCE is set, so it costs nothing at runtime.
+    target_compile_definitions(th08-modern PRIVATE TH08_RL_HARNESS TH08_ENABLE_REPLAY_TRACE)
+    if(NOT TH08_ENABLE_REPLAY_TRACE)
+        target_sources(th08-modern PRIVATE src/modern/linux/replay_trace.cpp)
+    endif()
+    # New code on a hot path (state export + protocol) keeps -O2; the
+    # reconstructed game TUs deliberately retain -O0.
+    set_source_files_properties(src/rlharness/rlharness.cpp PROPERTIES
+        COMPILE_OPTIONS "-O2;-fno-strict-aliasing")
+endif()
+
