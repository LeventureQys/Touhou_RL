@@ -84,6 +87,67 @@ C_ASSERT(sizeof(GameWindow) == 0x44);
 
 DIFFABLE_STATIC(HANDLE, g_ExclusiveMutex);
 DIFFABLE_STATIC(GameWindow, g_GameWindow);
+
+#ifdef TH08_RL_HARNESS
+namespace modern
+{
+namespace rlharness
+{
+// One logic frame, no frame-rate gate, no frame skipping.  This is
+// GameWindow::Render() minus the timing gate, and it must keep draw calls: some
+// draw callbacks mutate game state (10-P0 §4.1).
+RlU64 g_frameCount;
+
+RlU64 FrameCount()
+{
+    return g_frameCount;
+}
+
+void ResetFrameCount()
+{
+    g_frameCount = 0;
+}
+
+bool PumpOneFrame()
+{
+    i32 calcChainResult;
+
+    g_AnmManager->FlushVertexBuffer();
+
+    g_Supervisor.viewport.X = 0;
+    g_Supervisor.viewport.Y = 0;
+    g_Supervisor.viewport.Width = GAME_WINDOW_WIDTH;
+    g_Supervisor.viewport.Height = GAME_WINDOW_HEIGHT;
+    g_Supervisor.d3dDevice->SetViewport(&g_Supervisor.viewport);
+
+    calcChainResult = g_Chain.RunCalcChain();
+    g_SoundPlayer.ProcessQueues();
+
+    if (calcChainResult == 0 || calcChainResult == -1)
+    {
+        g_Supervisor.ThreadClose();
+        return false;
+    }
+
+    g_Supervisor.d3dDevice->BeginScene();
+    g_AnmManager->ClearVertexBuffer();
+    g_Supervisor.fogState = FOG_UNSET;
+    g_Supervisor.DisableFog();
+    g_Chain.RunDrawChain();
+    g_AnmManager->FlushVertexBuffer();
+    g_Supervisor.d3dDevice->SetTexture(0, NULL);
+    g_Supervisor.d3dDevice->EndScene();
+    g_GameWindow.framesSinceRedraw = 0;
+
+    GameWindow::Present();
+
+    ++g_frameCount;
+    return true;
+}
+} // namespace rlharness
+} // namespace modern
+#endif // TH08_RL_HARNESS
+
 }; // namespace th08
 
 using namespace th08;
