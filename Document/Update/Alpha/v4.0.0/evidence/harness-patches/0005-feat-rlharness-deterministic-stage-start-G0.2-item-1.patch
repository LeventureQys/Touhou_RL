+void ArmStart(u32 stage, u32 difficulty, u32 team, u16 seed, bool practice)
+{
+    g_startStage = stage;
+    g_startDifficulty = difficulty;
+    g_startTeam = team;
+    g_startSeed = seed;
+    g_startPractice = practice;
+    g_startArmed = true;
+}
+
+bool ConsumePendingStart()
+{
+    if (!g_startArmed)
+        return false;
+    g_startArmed = false;
+
+    g_GameManager.SetIsReplayWeird(FALSE);
+    g_GameManager.flags.isReplay = FALSE;
+    g_GameManager.flags.isDemoMode = FALSE;
+    g_GameManager.flags.isPracticeMode = g_startPractice ? TRUE : FALSE;
+    g_GameManager.flags.isSpellPractice = FALSE;
+    g_GameManager.difficulty = g_startDifficulty;
+    g_GameManager.shotType = g_startTeam;
+    g_GameManager.currentStage = static_cast<i32>(g_startStage);
+    g_GameManager.replayMode = REPLAY_MODE_NORMAL;
+
+    // Applied later, from inside GameManager's setup.
+    ArmSeed(g_startSeed);
+
+    g_Supervisor.curState = SupervisorState_GameManager;
+    g_Supervisor.StopAudio();
+    return true;
+}
