+// path, returns CHAIN_CALLBACK_RESULT_CONTINUE_AND_REMOVE_JOB so that the title
+// removes itself.  That is the only transition that leaves the chain healthy.
+void ArmStart(u32 stage, u32 difficulty, u32 team, u16 seed, bool practice);
+bool ConsumePendingStart();
