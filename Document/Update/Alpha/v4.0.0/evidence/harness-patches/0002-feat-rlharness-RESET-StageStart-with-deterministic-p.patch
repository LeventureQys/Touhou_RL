+// RESET <stage> <difficulty> <team> <seed> [practice]
+//
+// Mirrors TitleScreen::StartDeveloperReplayIfRequested() (TitleScreen.cpp:188-247),
+// the shortest path that leaves the title screen and enters a stage: set the
+// GameManager fields, then switch the supervisor to GameManager and let its
+// setup subthread run.
+void HandleReset(char *args)
+{
+    unsigned stage = 0;
+    unsigned difficulty = 1;
+    unsigned team = 0;
+    unsigned seed = 0;
+    unsigned practice = 0;
+    if (sscanf(args, "%u %u %u %u %u", &stage, &difficulty, &team, &seed, &practice) < 4)
+    {
+        Reply("ERR reset-usage RESET <stage> <difficulty> <team> <seed> [practice]");
+        return;
+    }
+    if (stage > 8 || difficulty > 4 || team > 11 || seed > 0xFFFF)
+    {
+        Reply("ERR reset-range stage<=8 difficulty<=4 team<=11 seed<=65535");
+        return;
+    }
+
+    g_GameManager.SetIsReplayWeird(FALSE);
+    g_GameManager.flags.isReplay = FALSE;
+    g_GameManager.flags.isDemoMode = FALSE;
+    g_GameManager.flags.isPracticeMode = practice ? TRUE : FALSE;
+    g_GameManager.flags.isSpellPractice = FALSE;
+    g_GameManager.difficulty = difficulty;
+    g_GameManager.shotType = team;
+    g_GameManager.currentStage = static_cast<i32>(stage);
+    g_GameManager.replayMode = REPLAY_MODE_NORMAL;
+
+    // The seed is applied from inside GameManager's setup, not here: setup draws
+    // from the RNG first (anti-tamper consumes values), so setting it now would
+    // be overwritten before stageRngSeed is recorded.
+    ArmSeed(static_cast<u16>(seed));
+
+    for (int i = 0; i < MAX_STAGES; ++i)
+        g_stageOriginSet[i] = false;
+
+    g_Supervisor.curState = SupervisorState_GameManager;
+    g_Supervisor.StopAudio();
+
+    // Setup runs on its own subthread; pump until it reports completion.
+    const unsigned kMaxSetupFrames = 1800;
+    unsigned pumped = 0;
+    bool ready = false;
+    while (pumped < kMaxSetupFrames)
+    {
+        if (!PumpOneFrame())
+            break;
+        ++pumped;
+        if (g_GameManager.gameplaySetupState == GAMEPLAY_SETUP_COMPLETE &&
+            g_Supervisor.runningSubthreadHandle == NULL)
+        {
+            ready = true;
+            break;
+        }
+    }
+
+    // Authoritative seed pin, and the reason it is here rather than only inside
+    // GameManager's setup: the setup runs on a subthread while the main loop
+    // keeps pumping frames, so the two threads interleave their draws from the
+    // shared RNG and the state on exit varies run to run (measured: same seed,
+    // same inputs, different g_Rng seed afterwards).  Reseeding at the quiescent
+    // point — setup complete, subthread gone, main thread in control — makes the
+    // first gameplay frame start from an identical RNG in every run.
+    if (ready)
+    {
+        g_Rng.SetSeed(static_cast<u16>(seed));
+        // Gameplay globals are allocated by the first gameplay frame, so the
+        // state right at setup completion is not yet readable.  Pump until they
+        // exist; this consumption happens after the reseed, so it is deterministic.
+        for (int i = 0; i < 8 && g_GameManager.globals == NULL; ++i)
+        {
+            if (!PumpOneFrame())
+                break;
+            ++pumped;
+        }
+    }
+
+    u32 fields[25];
+    RlU64 hash = 0;
+    // Frame 0 is the first frame of the stage, so two runs of the same seed are
+    // comparable even though setup needed a different number of frames.
+    ResetFrameCount();
+    if (TrackedFields(fields))
+    {
+        hash = 14695981039346656037ULL;
+        for (int i = 0; i < 25; ++i)
+            hash = Fnv1a(hash, fields[i]);
+    }
+    Reply("OK reset=1 ready=%u setup_frames=%u frames=%llu stage=%u difficulty=%u team=%u seed=%u "
+          "setup_state=%u hash=%016llx",
+          ready ? 1u : 0u, pumped, static_cast<unsigned long long>(FrameCount()), stage, difficulty,
+          team, seed, static_cast<unsigned>(g_GameManager.gameplaySetupState),
+          static_cast<unsigned long long>(hash));
+}
 } // namespace
 
+void ArmSeed(u16 seed)
+{
+    g_pendingSeed = seed;
+    g_seedArmed = true;
+}
+
+void ApplyPendingSeed()
+{
+    if (!g_seedArmed)
+        return;
+    g_seedArmed = false;
+    g_Rng.SetSeed(g_pendingSeed);
+}
+
 bool ParseCommandLine()
 {
     int inFd = 0;
@@ -324,6 +446,8 @@ int Run()
             HandleState();
         else if (strcmp(line, "STEP") == 0)
             HandleStep(args ? args : (char *)"");
+        else if (strcmp(line, "RESET") == 0)
+            HandleReset(args ? args : (char *)"");
         else if (strcmp(line, "QUIT") == 0)
         {
             Reply("OK bye");
diff --git a/src/rlharness/rlharness.hpp b/src/rlharness/rlharness.hpp
index b08ac5a..6ea4aa5 100644
--- a/src/rlharness/rlharness.hpp
+++ b/src/rlharness/rlharness.hpp
@@ -52,6 +52,21 @@ bool PumpOneFrame();
 
 // Implemented in main.cpp: how many logic frames this process has executed.
 RlU64 FrameCount();
+
+// Implemented in main.cpp: rewind the frame counter to zero.  STAGE START CALLS
+// THIS: the setup subthread needs a scheduler-dependent number of frames to
+// finish, so a process-wide counter would differ between two runs of the same
+// seed and poison the state hash.  After a reset, frame 0 is the first frame of
+// the stage, which is also what the replay trace's field 0 means.
+void ResetFrameCount();
+
+// RESET support.  The seed cannot be applied when the command is parsed: the
+// engine draws from the RNG during setup (anti-tamper consumes two values), so
+// the seed has to land at the one place that mirrors the replay path — right
+// before GameManager records stageRngSeed (10-P0 §4.3).  ArmSeed() only stores
+// it; GameManager's setup calls ApplyPendingSeed() for it.
+void ArmSeed(u16 seed);
+void ApplyPendingSeed();
 }
 }
 }
