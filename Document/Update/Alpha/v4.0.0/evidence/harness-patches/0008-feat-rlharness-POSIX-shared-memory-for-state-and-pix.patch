+// Shared-memory layout (10-P0 §3).
+//
+//   [0, 64)      header: magic, protocol version, frame, state hash, sizes
+//   [64, 192)    the 25 tracked fields, as u32
+//   [192, ...)   pixels, RGBA8, 640x480
+//
+// The control pipe carries commands and short replies; bulk data lands here so
+// the Python side can map the same pages.  Only the frame owner writes; readers
+// take the header's frame counter as the seqlock value.
+bool g_shmActive;
+void *g_shmBase;
+size_t g_shmSize;
+char g_shmName[128];
+
+static const size_t SHM_HEADER_OFFSET = 0;
+static const size_t SHM_STATE_OFFSET = 64;
+static const size_t SHM_PIXELS_OFFSET = 192;
+static const u32 SHM_MAGIC = 0x30303456u; // "V400"
+static const u32 SHM_VERSION = 1;
+
+struct ShmHeader
+{
+    u32 magic;
+    u32 version;
+    unsigned long long frame;
+    unsigned long long stateHash;
+    u32 pixelWidth;
+    u32 pixelHeight;
+    u32 stateBytes;
+    u32 flags;
+};
+
+// flags bits
+static const u32 SHM_FLAG_STATE_VALID = 1u << 0;
+static const u32 SHM_FLAG_PIXELS_VALID = 1u << 1;
+
+bool AttachShared(const char *name)
+{
+    if (name == NULL || name[0] == '\0')
+        return false;
+    const size_t total = SHM_PIXELS_OFFSET + 640u * 480u * 4u;
+    const int fd = shm_open(name, O_CREAT | O_RDWR, 0600);
+    if (fd < 0)
+        return false;
+    if (ftruncate(fd, static_cast<off_t>(total)) != 0)
+    {
+        close(fd);
+        return false;
+    }
+    void *base = mmap(NULL, total, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    close(fd);
+    if (base == MAP_FAILED)
+        return false;
+
+    g_shmBase = base;
+    g_shmSize = total;
+    g_shmActive = true;
+    strncpy(g_shmName, name, sizeof(g_shmName) - 1);
+    g_shmName[sizeof(g_shmName) - 1] = '\0';
+
+    ShmHeader *header = static_cast<ShmHeader *>(g_shmBase);
+    memset(header, 0, sizeof(*header));
+    header->magic = SHM_MAGIC;
+    header->version = SHM_VERSION;
+    header->pixelWidth = 640;
+    header->pixelHeight = 480;
+    header->stateBytes = 25 * sizeof(u32);
+    return true;
+}
+
+void PublishState(const u32 fields[25], unsigned long long hash)
+{
+    if (!g_shmActive)
+        return;
+    ShmHeader *header = static_cast<ShmHeader *>(g_shmBase);
+    memcpy(static_cast<unsigned char *>(g_shmBase) + SHM_STATE_OFFSET, fields, 25 * sizeof(u32));
+    header->stateHash = hash;
+    header->frame = FrameCount();
+    header->flags |= SHM_FLAG_STATE_VALID;
+}
+
+void PublishPixels(const unsigned char *rgba)
+{
+    if (!g_shmActive || rgba == NULL)
+        return;
+    ShmHeader *header = static_cast<ShmHeader *>(g_shmBase);
+    memcpy(static_cast<unsigned char *>(g_shmBase) + SHM_PIXELS_OFFSET, rgba, 640u * 480u * 4u);
+    header->frame = FrameCount();
+    header->flags |= SHM_FLAG_PIXELS_VALID;
+}
+
+// SHM <name>: attach (and create if needed) the shared block.
+void HandleShm(char *args)
+{
+    if (args == NULL || args[0] == '\0')
+    {
+        Reply("OK shm=%s active=%u bytes=%llu", g_shmActive ? g_shmName : "",
+              g_shmActive ? 1u : 0u, static_cast<unsigned long long>(g_shmSize));
+        return;
+    }
+    if (!AttachShared(args))
+    {
+        Reply("ERR shm-attach-failed %s", args);
+        return;
+    }
+    Reply("OK shm=%s active=1 bytes=%llu", g_shmName, static_cast<unsigned long long>(g_shmSize));
+}
+
 bool ParseCommandLine()
 {
     int inFd = 0;
@@ -649,6 +768,8 @@ int Run()
             HandlePixels(args ? args : (char *)"");
         else if (strcmp(line, "READBACK") == 0)
             HandleReadback(args ? args : (char *)"");
+        else if (strcmp(line, "SHM") == 0)
+            HandleShm(args ? args : (char *)"");
         else if (strcmp(line, "DEBUG") == 0)
             HandleDebug();
         else if (strcmp(line, "QUIT") == 0)
