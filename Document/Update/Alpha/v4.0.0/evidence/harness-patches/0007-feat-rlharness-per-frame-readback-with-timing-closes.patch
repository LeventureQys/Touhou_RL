+// Per-frame observation readback (env role).
+//
+// glReadPixels is synchronous and stalls until the rasterizer has finished, so
+// its cost is exactly what P0-WP2 still owes.  The timing is accumulated here so
+// the Python side can difference two STEP runs (readback on vs off) instead of
+// guessing from wall clock, which would also include Python round-trip time.
+bool g_readbackEnabled;
+unsigned long long g_readbackFrames;
+unsigned long long g_readbackMicros;
+static unsigned char g_readbackBuffer[640 * 480 * 4];
+
+static unsigned long long NowMicros()
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return static_cast<unsigned long long>(ts.tv_sec) * 1000000ULL +
+           static_cast<unsigned long long>(ts.tv_nsec) / 1000ULL;
+}
+
+void SetReadback(bool enabled)
+{
+    g_readbackEnabled = enabled;
+}
+
+unsigned long long ReadbackFrames()
+{
+    return g_readbackFrames;
+}
+
+unsigned long long ReadbackMicros()
+{
+    return g_readbackMicros;
+}
+
+void AfterDrawFrame()
+{
+    if (!g_readbackEnabled)
+        return;
+    const unsigned long long start = NowMicros();
+    glReadPixels(0, 0, 640, 480, GL_RGBA, GL_UNSIGNED_BYTE, g_readbackBuffer);
+    g_readbackMicros += NowMicros() - start;
+    ++g_readbackFrames;
+}
+
+// READBACK <0|1>: turn the per-frame observation readback on or off, and report
+// the accumulated cost so far.
+void HandleReadback(char *args)
+{
+    unsigned enabled = 0;
+    if (args != NULL && sscanf(args, "%u", &enabled) == 1)
+        SetReadback(enabled != 0);
+    Reply("OK readback=%u frames=%llu micros=%llu", g_readbackEnabled ? 1u : 0u,
+          ReadbackFrames(), ReadbackMicros());
+}
+
 bool ParseCommandLine()
 {
     int inFd = 0;
@@ -591,6 +647,8 @@ int Run()
             HandleReset(args ? args : (char *)"");
         else if (strcmp(line, "PIXELS") == 0)
             HandlePixels(args ? args : (char *)"");
+        else if (strcmp(line, "READBACK") == 0)
+            HandleReadback(args ? args : (char *)"");
         else if (strcmp(line, "DEBUG") == 0)
             HandleDebug();
         else if (strcmp(line, "QUIT") == 0)
