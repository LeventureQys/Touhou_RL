# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Virtual environments
.venv/
venv/

# Run artifacts live under the game submodule's build/ (gitignored there):
#   third_party/th08/build/{play,rl,probes,evidence,...}
# Keep datasets, checkpoints, screenshots and probe JSON out of the repository.

# Editor / OS noise
.vscode/
.idea/
Thumbs.db
desktop.ini

# Local scratch
*.log
scratch/

# Local scratch directories from agent / experiment runs.  Measured 2026-11-02:
# 27 dirs, 2.7 GB at the repository root (`.tmp_cache_contract_round7_a`,
# `.tmp_full_round28`, `.tmp_p0fence_full`, ...).  Never evidence: anything worth
# keeping is copied into Document/Update/Alpha/<version>/ before a version is
# settled, so these are safe to delete at any time.
.tmp_*/
# Root-anchored only: pytest/tempfile leftovers (`tmp5g1679c_`) are created at
# the repo root, and a bare `tmp*/` would also swallow future source dirs.
/tmp*/
*.tmp
*.temp
*~
*.orig
*.rej
.DS_Store

# DSH local scratch (not part of the deliverable)
.pytest-tmp/
.pytest-*/
.scratch-probe/
.tmp/
.tmp-*/

# v3.5.0 probe traces (large JSONL/NPZ; regenerate with touhou_rl.probe35)
Document/Update/Alpha/v3.5.0/probe/*/trace/
Document/Update/Alpha/v3.5.0/probe/*/bullets/

# v3.6.0 feature cache (15 MB derivative of the S0 traces; regenerate in ~53 s
# with `python -m touhou_rl.ablate36 --cache <path>`).  Not evidence: np.savez
# stamps entries with the current time, so its hash is not reproducible.
Document/Update/Alpha/v3.6.0/data/features-*.npz
# v3.6.0 probe traces (large JSONL/NPZ; regenerate with touhou_rl.probe35 collect)
Document/Update/Alpha/v3.6.0/data/probe/*/trace/
Document/Update/Alpha/v3.6.0/data/probe/*/bullets/
# v3.6.1 T2 probe traces (same reasoning; 40 episodes ~1.1 GB)
Document/Update/Alpha/v3.6.1/data/probe/*/trace/
Document/Update/Alpha/v3.6.1/data/probe/*/bullets/

# ---------------------------------------------------------------------------
# v3.7.x live-session and synthetic-experiment payload (measured 2026-11-02:
# 9.7 GB under v3.7.3 alone, 18.2 GB under v2.0.0).  The auditable evidence
# stays in the repository as md/json/png/svg/jsonl; what follows does not.
# ---------------------------------------------------------------------------

# Per-run copies of the game itself.  Every `evidence/*/session/` directory is a
# full copy of the TH08 install (th08.exe, th08.dat, thbgm.dat).  Copyrighted
# (ZUN / Team Shanghai Alice) and over GitHub's 100 MB per-file hard limit.
**/session/
*.dat
*.exe

# Research weights and pixel tensors.  `pixels.pt` alone is 119 MB and there are
# 319 of them; none is a deployable model (all are research-only), and the
# README states the default model has never been replaced.
*.pt
*.pth

# Frame caches, 78 MB each (capture-round5/6).  The small raw.npz evidence
# (~1 MB, regenerable) is deliberately kept.
**/frames.npz
